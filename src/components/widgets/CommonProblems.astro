---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';

export interface Props {
  showImage?: boolean;
}

const { showImage = true } = Astro.props;

const commonProblems: Array<{ problem: string; outcome: string }> = [
  {
    problem: 'My computer is full and crawling.',
    outcome:
      "Cleaned up, photos backed up, and running smoothly again. If it's time for a new one, we'll help you choose.",
  },
  {
    problem: "I keep getting scary pop-ups and I'm afraid to click anything.",
    outcome: "Viruses and scams removed, protection set up, and you'll know how to spot the next one.",
  },
  {
    problem: "I can't remember any of my passwords.",
    outcome: "A simple password manager, so there's just one password to remember.",
  },
  {
    problem: "The Wi-Fi doesn't reach my bedroom.",
    outcome: 'Reliable Wi-Fi in the rooms you actually use.',
  },
  {
    problem: "I'm scared of losing my family photos.",
    outcome: "Photos backed up automatically, so they're safe even if a device fails.",
  },
  {
    problem: 'Every time something breaks, I have to explain everything to a stranger.',
    outcome: 'One local team that already knows your home and your devices.',
  },
];
---

<WidgetWrapper>
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-brand-light/10 dark:bg-transparent"></div>
  </Fragment>

  <Headline title="Common Problems We Solve" />

  {
    showImage ? (
      <div class="md:flex md:items-center md:gap-12 mb-12">
        <div class="md:basis-1/2 mb-8 md:mb-0">
          <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">You're Not Alone</h3>
          <p class="text-lg text-muted dark:text-slate-400">
            These problems happen to everyone. We've helped 100+ Tucson families solve them.
          </p>
        </div>
        <div class="md:basis-1/2">
          <Image
            src="~/assets/images/devan-assisting-client.jpg"
            alt="Devan from Mobile-Tech helping a customer with her laptop at home"
            class="mx-auto w-full rounded-lg shadow-lg"
            width={1536}
            height={1024}
            widths={[400, 768]}
            sizes="(max-width: 768px) 100vw, 560px"
            layout="responsive"
          />
        </div>
      </div>
    ) : (
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">You're Not Alone</h3>
        <p class="text-lg text-muted dark:text-slate-400">
          These problems happen to everyone. We've helped 100+ Tucson families solve them.
        </p>
      </div>
    )
  }

  <div
    class="hidden md:grid md:grid-cols-2 md:gap-6 px-6 pb-3 text-sm font-semibold uppercase tracking-wide text-muted dark:text-slate-400"
  >
    <p>The problem</p>
    <p>After Mobile-Tech</p>
  </div>
  <ul class="space-y-4">
    {
      commonProblems.map(({ problem, outcome }) => (
        <li class="grid gap-3 md:grid-cols-2 md:gap-6 rounded-lg border border-brand-light/20 bg-white dark:bg-brand-medium p-5 md:px-6">
          <p class="flex items-start gap-3 italic text-gray-700 dark:text-slate-300">
            <Icon name="tabler:alert-circle" class="w-6 h-6 shrink-0 text-gray-400" />
            <span>"{problem}"</span>
          </p>
          <p class="flex items-start gap-3 font-medium dark:text-white">
            <Icon name="tabler:circle-check" class="w-6 h-6 shrink-0 text-primary" />
            <span>{outcome}</span>
          </p>
        </li>
      ))
    }
  </ul>
</WidgetWrapper>

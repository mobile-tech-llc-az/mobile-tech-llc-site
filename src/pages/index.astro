---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';

const metadata = {
  title: 'Mobile-Tech LLC - Friendly Computer Help for Tucson Residents',
  ignoreTitleTemplate: true,
  description:
    'Mobile-Tech, LLC is a personal IT department for Tucson-area homes, offering ongoing membership plans and friendly, patient one-time computer help. Serving Tucson, Arizona since 2005.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Call for Help',
        href: 'tel:520-314-7152',
        icon: 'tabler:phone',
      },
      {
        variant: 'primary',
        text: 'Book a Visit',
        href: '/contact',
        icon: 'tabler:calendar',
      },
    ]}
    image={{
      src: '~/assets/images/mt-logo-transparent-graphic-only.png',
      alt: 'Mobile-Tech LLC Logo',
      class: 'w-64 h-auto mx-auto object-contain',
      width: 256,
      height: 256,
      widths: [256, 512],
      sizes: '16rem',
    }}
  >
    <Fragment slot="title">
      Friendly <span class="text-[#816bb1] sm:pr-[0.25em]">Computer Help</span><br class="block sm:hidden" />
      <span class="hidden sm:inline">for </span>Tucson <span class="hidden xl:inline">Area </span>Residents
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg">
        <strong>Slow computer? Scary pop-ups? Wi-Fi that won't reach the bedroom?</strong>
      </span><br /><br />
      <span class="text-base">
        Mobile-Tech is a local Tucson team that becomes your home's personal IT department. We help with computers,
        phones, tablets, Wi-Fi, TVs, and printers, at your home or remotely. Unlike a one-time repair call, a membership
        means we already know your setup, keep an eye out for problems before they start, and are there when you need
        us. Just need one-time help? We do that too.
      </span>
    </Fragment>
  </Hero>

  <!-- Features3 Widget ************** -->

  <Features3
    title="A Personal IT Department for Your Home"
    subtitle="Instead of calling a stranger every time something breaks, get an ongoing relationship with a local team that already knows your home."
    columns={3}
    items={[
      {
        title: 'Home Essentials - $79/mo',
        description:
          '<strong>"Teach me and back me up."</strong> Guided self-service with a trusted backstop when you get stuck.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Home Complete - $149/mo',
        description:
          '<strong>"Help me manage it."</strong> Our most popular membership for a typical household that wants us to handle the details alongside you.',
        icon: 'tabler:home-cog',
      },
      {
        title: 'Home Concierge - $229+/mo',
        description:
          '<strong>"Handle it for me."</strong> Premium and comprehensive coverage for larger households and families.',
        icon: 'tabler:crown',
      },
    ]}
  />

  <div class="text-center -mt-8 mb-16">
    <p class="max-w-3xl mx-auto px-4 sm:px-6 mb-6 text-gray-600 dark:text-slate-400">
      Every plan includes proactive monitoring, security tools, included help time each month, and a discounted $99/hr
      rate for anything extra.
    </p>
    <Button variant="primary" href="/pricing" text="See Membership Plans & Pricing" icon="tabler:arrow-right" />
  </div>

  <!-- Features Widget *************** -->

  <Features
    id="services"
    title="We Help With Your Everyday Tech Problems"
    subtitle="These are the most common issues we solve for our customers every day."
    items={[
      {
        title: 'Computer Running Slow or Acting Up',
        description:
          "Virus removal, cleaning up your hard drive, making your computer fast again. We fix computers that freeze, crash, or won't start.",
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Phone & iPad Help',
        description:
          'iPhone, iPad, and Android setup. Help with apps, photos, texting, email, and making your devices easier to use.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Internet & WiFi Problems',
        description:
          "Can't get online? WiFi not working? We fix internet problems and help you get better, faster internet service.",
        icon: 'tabler:wifi',
      },
      {
        title: 'Email & Password Issues',
        description:
          "Gmail, Yahoo, Outlook problems. Forgotten passwords, can't log in, or setting up a password manager.",
        icon: 'tabler:mail',
      },
      {
        title: 'TV & Streaming Setup',
        description:
          'Setting up Netflix, mounting TVs, programming remote controls, and switching from cable to streaming services.',
        icon: 'tabler:device-tv',
      },
      {
        title: 'Backing Up Your Photos & Files',
        description:
          "Don't lose your precious photos! We help save your files to the cloud or local storage and show you how to keep them safe.",
        icon: 'tabler:photo',
      },
      {
        title: 'Help Choosing New Technology',
        description:
          "Need a new computer, TV, or streaming device? We research the best options and help you choose what's right for your needs and budget.",
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Printer Setup & Troubleshooting',
        description:
          "Setting up new printers, fixing printing problems, and helping you print from your phone or tablet. If you're shopping for a new one, we can recommend a reliable model that fits how you print.",
        icon: 'tabler:printer',
      },
    ]}
  />

  <div class="mb-8 md:mb-12"></div>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    title="Why Choose Us?"
    items={[
      {
        title: 'We Come to You',
        description: 'No need to unplug your computer or drive anywhere. We come to your home at your convenience.',
      },
      {
        title: 'Patient & Understanding',
        description:
          'We explain everything in plain English and never make you feel rushed or embarrassed about asking questions.',
      },
      {
        title: 'Honest Pricing',
        description:
          'Clear, upfront pricing, whether you choose a membership plan or pay hourly. We only recommend what you actually need.',
      },
      {
        title: 'Local Tucson Business',
        description: "We live and work in Tucson. We're your neighbors, and we care about serving our community well.",
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1576091160550-2173dba999ef?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Person getting computer help',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Serving Tucson with Care</h3>
      We understand that technology can be frustrating. That's why we focus on making it simple and stress-free for you.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-brand-light/10 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    title="Common Problems We Solve"
    items={[
      {
        title: '"My computer is full and running slow"',
        description:
          "We clean up your computer, back up your photos to the cloud, and get it running smoothly again. If it's time for a new one, we'll help you choose a replacement that fits your needs and budget.",
      },
      {
        title: '"I keep getting scary pop-up messages"',
        description: 'We remove viruses and malware, then show you how to avoid them in the future.',
      },
      {
        title: '"I forgot all my passwords"',
        description:
          'We help you reset passwords and set up a simple password manager so you only need to remember one master password.',
      },
      {
        title: '"My WiFi doesn\'t reach my bedroom"',
        description: 'We improve your WiFi coverage throughout your home so you can use the internet anywhere.',
      },
    ]}
    image={{
      src: '~/assets/images/devan-assisting-client.jpg',
      alt: 'Devan from Mobile-Tech helping a customer with her laptop at home',
      width: 1536,
      height: 1024,
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">You're Not Alone</h3>
      These problems happen to everyone. We've helped 100+ Tucson families solve them.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-brand-light/10 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'See Membership Plans',
        href: '/pricing',
        icon: 'tabler:list-check',
      },
      {
        variant: 'primary',
        text: 'Contact Us Today',
        href: '/contact',
        icon: 'tabler:calendar',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Get Your<br class="block sm:hidden" /><span class="sm:whitespace-nowrap sm:ml-[0.25em]">
        Technology Working?</span
      >
    </Fragment>

    <Fragment slot="subtitle">
      <strong>Friendly, local help, often same-day for Concierge members.</strong>
    </Fragment>
  </CallToAction>
</Layout>

---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';

const metadata = {
  title: 'Residential Tech Support Services',
  description:
    'Ongoing personal IT department membership plans and one-time computer help for Tucson-area homes. Mobile-Tech gets to know your home and is there when something breaks.',
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Residential Technology Support',
  name: 'Mobile-Tech Residential Services',
  provider: {
    '@type': 'ProfessionalService',
    name: 'Mobile-Tech, LLC',
  },
  areaServed: {
    '@type': 'City',
    name: 'Tucson, Arizona',
  },
  description:
    'Ongoing personal IT department membership plans and one-time technology help for Tucson-area homes, including computer repair, network support, smart-home setup, and technology purchasing guidance.',
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Your Personal IT Department"
    title="Home Technology Support in Tucson"
    subtitle="We help families and individuals with all their home technology needs.  Our ongoing membership gets to know you and your home, watches over it proactively, and is there when something goes wrong. Prefer one-time help instead? We do that too."
    actions={[
      {
        variant: 'primary',
        text: 'See Membership Plans',
        href: '/pricing',
        icon: 'tabler:list-check',
      },
      {
        variant: 'primary',
        text: 'Book a Visit',
        href: '/contact',
        icon: 'tabler:calendar',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1576091160550-2173dba999ef?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Home tech support services',
    }}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Now Offering: Personal IT Department Memberships"
    subtitle="Instead of calling a stranger every time something breaks, get an ongoing relationship with a local team that already knows your home."
    columns={3}
    items={[
      {
        title: 'Home Essentials ($79/mo)',
        description:
          '<strong>"Teach me and back me up."</strong> Guided self-service with a trusted backstop when you get stuck.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Home Complete ($149/mo)',
        description:
          '<strong>"Help me manage it."</strong> Our most popular membership for a typical household that wants us to handle the details along side you.',
        icon: 'tabler:home-cog',
      },
      {
        title: 'Home Concierge ($229+/mo)',
        description:
          '<strong>"Handle it for me."</strong> Premium and comprehensive coverage for larger households and families.',
        icon: 'tabler:crown',
      },
    ]}
  />

  <div class="text-center -mt-8 mb-16">
    <Button variant="primary" href="/pricing" text="Compare All Plans & Pricing" icon="tabler:arrow-right" />
  </div>

  <!-- Features2 Widget ************** -->

  <Features2
    title="What's Offered in Your Membership"
    subtitle="These are the everyday tech needs your membership covers, plus a non-member hourly rate if you'd rather pay as you go."
    columns={2}
    items={[
      {
        title: 'Computer Running Slow or Acting Up',
        description:
          "Virus removal, cleaning up your hard drive, making your computer fast again. We fix computers that freeze, crash, or won't start properly.",
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Phone & iPad Help',
        description:
          'iPhone, iPad, and Android setup and troubleshooting. Help with apps, photos, texting, email, and making your devices easier to use.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Internet & WiFi Problems',
        description:
          "Can't get online? WiFi not working in some rooms? We fix internet problems and help you get better, faster internet service throughout your home. We'll even help you switch internet providers and plans.",
        icon: 'tabler:wifi',
      },
      {
        title: 'Email & Password Issues',
        description:
          "Gmail, Yahoo, Outlook problems. Forgotten passwords, can't log in, or setting up a password manager.",
        icon: 'tabler:mail',
      },
      {
        title: 'TV & Streaming Setup',
        description:
          'Setting up Netflix, Hulu, Disney+, mounting TVs, programming remote controls, and switching from cable to streaming services and setup of Roku or Apple TV.',
        icon: 'tabler:device-tv',
      },
      {
        title: 'Backing Up Your Photos & Files',
        description:
          "Don't lose your precious photos! We help save your files to the cloud or local storage and show you how to keep them safe.",
        icon: 'tabler:photo',
      },
      {
        title: 'Printer Setup & Problems',
        description:
          'Setting up new printers, fixing printing issues, connecting wireless printers, and helping you print from your phone or tablet.',
        icon: 'tabler:printer',
      },
      {
        title: 'Smart Home Setup',
        description:
          'Security cameras, smart doorbells, voice assistants (Alexa, Google), smart thermostats, and other connected home devices.',
        icon: 'tabler:home',
      },
      {
        title: 'Computer Hardware Upgrades',
        description:
          'Upgrading RAM and SSD drives to make older computers faster, replacing broken computers, and helping you choose the right new equipment.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Software Training',
        description:
          'Learn to use your computer, phone, or tablet more effectively. Training on your favorite apps, video calling, online shopping, and staying safe online.',
        icon: 'tabler:school',
      },
      {
        title: 'PC to Mac Migration',
        description:
          'Thinking of switching to a Mac? We help transfer all your files, photos, and settings from your old PC to your new Mac computer.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Virus & Malware Removal',
        description:
          'Getting scary pop-ups or suspicious emails? We remove viruses, malware, and other threats, then show you how to stay protected.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Technology Purchasing Consultation',
        description:
          'Need a new computer, TV, Audio equipment, or streaming device? We research options, explain differences, and help you choose the right technology for your needs and budget.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Windows user?',
        description:
          "We can help you find a PC that meets your needs, whether it's a new computer or an upgrade to your existing one. Our goal is to help your purchase a computer that will last for years to come.",
        icon: 'tabler:brand-windows',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'We Come to Your Home',
        description:
          "No need to unplug your computer or drive anywhere. We come to your house at a time that's convenient for you.",
        icon: 'tabler:home-move',
      },
      {
        title: 'Patient & Understanding',
        description:
          'We explain everything in plain English and never make you feel rushed or embarrassed about asking questions. Technology should be simple.',
        icon: 'tabler:heart',
      },
      {
        title: 'One Team, No Starting Over',
        description:
          "With a membership, you're not explaining your setup to a new person every time something breaks. We already know your home, your accounts, and your history.",
        icon: 'tabler:users',
      },
      {
        title: 'Same-Day Service Available',
        description:
          'Need help urgently? We often can come the same day you call, especially for critical issues that affect your daily routine.',
        icon: 'tabler:clock',
      },
    ]}
    image={{
      src: '~/assets/images/devan-assisting-client.jpg',
      alt: 'Devan from Mobile-Tech helping a customer with her laptop at home',
      width: 1536,
      height: 1024,
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Why Tucson Families Choose Us</h3>
      We understand that every home has different technology needs. That's why we built a membership that acts like a personal
      IT department for your family, one team that already knows your setup. Each membership is tailored to your household
      tech needs.
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: '"My computer is so slow I want to throw it out the window"',
        description:
          'We hear this all the time! Usually it just needs a good cleaning, virus removal, and some optimization. Most computers can run like new again.',
        icon: 'tabler:device-desktop',
      },
      {
        title: '"I keep getting scary messages about viruses"',
        description:
          'These are often fake scare tactics, but we can remove real scams or warnings and fix vulnerabilities. We will show you how to tell the difference between real and fake threats.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: '"My WiFi doesn\'t work in my bedroom"',
        description:
          'Dead zones are common in larger homes. We can extend your WiFi coverage so you get strong internet everywhere in your house.',
        icon: 'tabler:wifi-off',
      },
      {
        title: '"I can\'t remember any of my passwords"',
        description:
          'Password managers make this easy! We set up a secure system so you only need to remember one master password for everything.',
        icon: 'tabler:key',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Common computer problems solved',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Common Problems We Solve</h3>
      These are real things our customers tell us every day. Sound familiar? We can help!
    </Fragment>
  </Content>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'See Membership Plans',
        href: '/pricing',
        icon: 'tabler:list-check',
      },
      {
        variant: 'primary',
        text: 'Book a Visit',
        href: '/contact',
        icon: 'tabler:calendar',
      },
    ]}
    title="Ready for a Personal IT Department of Your Own?"
    subtitle="See our membership plans, or book a one-time visit. Either way, we're here to help. Same-day service is often available."
  />
</Layout>

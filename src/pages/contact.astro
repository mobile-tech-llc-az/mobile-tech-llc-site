---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import { INTAKE_FORM_URL } from '~/forms';

const metadata = {
  title: 'Contact Us',
  description:
    "Schedule an on-site visit or ask about Mobile-Tech, LLC's membership plans. Serving Tucson, Arizona and surrounding areas.",
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact Mobile-Tech, LLC" title="Ready to Schedule Your Visit?" />

  <div class="px-4 py-16 mx-auto max-w-6xl lg:px-8 lg:py-20">
    <div class="max-w-xl mx-auto">
      <div class="text-center pb-12 md:pb-16">
        <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
          Schedule Your On-Site Visit
        </h2>
        <p class="text-xl text-muted mb-4">Book a convenient time for one of our team members to visit you.</p>
        <p class="text-2xl md:text-3xl font-bold text-primary dark:text-white">
          Call us at (520) 314-7152 or tell us what you need below
        </p>
      </div>

      <div class="mb-12">
        <h3 class="text-2xl font-bold mb-4 text-center text-primary dark:text-white">Request Service</h3>
        <p class="text-muted mb-6 text-center">
          Fill out this short form and we'll get back to you within 1 business day.
        </p>
        <!-- The form is one column at every width; these heights fit all 14 questions without an inner scrollbar (measured: ~3670px phone, ~3460px desktop). -->
        <iframe
          id="intake-form"
          src={`${INTAKE_FORM_URL}?embedded=true`}
          title="Request service from Mobile-Tech, LLC"
          class="block w-full h-[3800px] md:h-[3550px] border-0 rounded-lg bg-white"
          loading="lazy"
        >
          Loading…
        </iframe>
      </div>

      <div class="bg-white dark:bg-brand-medium rounded-lg shadow-lg p-8 border border-brand-light/20">
        <div class="text-center">
          <h3 class="text-2xl font-bold mb-4 text-primary dark:text-white">Book Online</h3>
          <p class="text-muted mb-6">Already know what you need? Pick a time that works for you on our calendar:</p>
          <a
            href="https://calendar.app.google/7RcPw78n1ixTajYK6"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-primary hover:bg-primary/90 text-white font-bold py-3 px-8 rounded-lg transition-colors duration-200"
          >
            📅 Schedule Appointment
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Features2 Widget ************** -->

  <Features2
    title="Multiple Ways to Reach Us"
    items={[
      {
        title: 'Phone Support',
        description: '520-314-7152',
        icon: 'tabler:phone',
      },
      {
        title: 'Email Us',
        description:
          '<a href="mailto:mobiletechllcaz@gmail.com" class="underline text-primary dark:text-white">mobiletechllcaz@gmail.com</a>',
        icon: 'tabler:mail',
      },
      {
        title: 'Service Area',
        description: 'Mobile service throughout Tucson, Arizona. We come to you!',
        icon: 'tabler:map-pin',
      },
    ]}
  />

  <script>
    // Google shows its short "thank you" page in the same tall frame after Submit.
    // Scroll back up to it so the visitor isn't left looking at blank space.
    const form = document.getElementById('intake-form');
    let loads = 0;
    form?.addEventListener('load', () => {
      if (++loads > 1) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>
</Layout>
